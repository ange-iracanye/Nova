# Nova environment
# development | production
NOVA_ENV=development

# Production: comma-separated exact browser origins.
# Example:
# NOVA_ALLOWED_ORIGINS=https://nova-frontend.onrender.com
NOVA_ALLOWED_ORIGINS=

# Frontend API base URL
# Local:
VITE_API_URL=http://127.0.0.1:8000
# Production example:
# VITE_API_URL=https://nova-api.onrender.com

# Ollama endpoint used by the backend LLM layer.
# Local Ollama normally uses its default local endpoint.
# For hosted Ollama, set the provider endpoint here.
OLLAMA_HOST=

# Keep the model configurable for deployment without code changes.
OLLAMA_MODEL=qwen2.5:1.5b
