# Nova environment
# development | production
NOVA_ENV=development

# Production: comma-separated exact browser origins.
NOVA_ALLOWED_ORIGINS=

# Frontend API base URL
VITE_API_URL=http://127.0.0.1:8000

# Ollama endpoint used by the backend LLM layer.
OLLAMA_HOST=

# Local development baseline. Production Render overrides this explicitly.
OLLAMA_MODEL=qwen2.5:3b

# Production browser session settings.
NOVA_SESSION_COOKIE=nova_session
NOVA_COOKIE_SAMESITE=lax

# Production request protection.
NOVA_MAX_BODY_BYTES=524288
NOVA_MAX_UPLOAD_BYTES=10485760

# Fast-response cache. Safe only for repeated identical prompt/context pairs.
NOVA_FAST_CACHE_SIZE=128
NOVA_FAST_CACHE_TTL=300
NOVA_FAST_MAX_CHARS=16000
NOVA_FAST_WARMUP=1
