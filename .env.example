# Nova environment
# development | production
NOVA_ENV=development

# Production: exact HTTPS browser origin(s), comma-separated.
NOVA_ALLOWED_ORIGINS=

# Frontend API base URL
VITE_API_URL=http://127.0.0.1:8000

# Public V1 free AI provider. Never use a paid model in public V1.
NOVA_LLM_PROVIDER=openrouter
NOVA_LLM_MODEL=nvidia/nemotron-3-ultra:free
NOVA_LLM_FALLBACK_MODEL=openrouter/free
OPENROUTER_API_KEY=
NOVA_PUBLIC_URL=http://127.0.0.1:3000

# Free persistent PostgreSQL database (Supabase Free is supported)
NOVA_DATABASE_URL=

# Comma-separated email(s) allowed to open /analytics.
# Keep this private and set it only in the production environment.
NOVA_ANALYTICS_ADMIN_EMAILS=

# Local Ollama remains available when NOVA_LLM_PROVIDER=ollama.
OLLAMA_HOST=
OLLAMA_MODEL=qwen2.5:3b

# Production browser session settings.
NOVA_SESSION_COOKIE=nova_session
NOVA_COOKIE_SAMESITE=lax

# Production request protection.
NOVA_MAX_BODY_BYTES=524288
NOVA_MAX_UPLOAD_BYTES=10485760

# Fast-response cache.
NOVA_FAST_CACHE_SIZE=128
NOVA_FAST_CACHE_TTL=300
NOVA_FAST_MAX_CHARS=16000
NOVA_FAST_WARMUP=1
